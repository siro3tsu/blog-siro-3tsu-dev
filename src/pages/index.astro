---
import Layout from '../layouts/Layout.astro';
---

<Layout />
<style>
  @reference 'tailwindcss';
  @custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));
  h2 {
    @apply my-2 text-2xl font-semibold pl-2 pb-1 border-b border-gray-900 dark:border-gray-100;
  }
  h3 {
    @apply text-xl font-medium pl-2 my-2;
  }
  p {
    @apply my-1 leading-relaxed;
  }
</style>
