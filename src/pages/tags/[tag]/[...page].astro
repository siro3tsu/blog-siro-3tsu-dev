---
import type { GetStaticPathsOptions } from 'astro';
import { getSortedPosts, convertToSlug } from '@core/posts';
import PaginationLayout from '@layouts/PaginationLayout.astro';
import { siteConfig } from '@site.config';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const sortedPosts = await getSortedPosts();
  const uniqueTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags))];
  const tagSlugs = uniqueTags.map((tag) => convertToSlug(tag));

  return tagSlugs.flatMap((tag) => {
    const filteredPosts = sortedPosts.filter((post) => post.data.tags.map(convertToSlug).includes(tag));
    return paginate(filteredPosts, {
      params: {
        tag,
      },
      props: { tagName: uniqueTags.find((tagName) => convertToSlug(tagName) === tag) },
      pageSize: siteConfig.postsPerPage,
    });
  });
}
const { page, tagName } = Astro.props;
const { tag } = Astro.params;
---

<PaginationLayout
  page={page}
  title={`「${tagName}」タグのついた投稿`}
  basePath={`/tags/${tag}`}
  description={`「${tagName}」タグのついた投稿の一覧です。`}
/>
