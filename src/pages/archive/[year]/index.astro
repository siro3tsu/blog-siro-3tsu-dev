---
import { getSortedPosts } from '@core/posts';
import Layout from '@layouts/Layout.astro';

export async function getStaticPaths() {
  const sortedPosts = await getSortedPosts();
  // すべての投稿の中からすべての年（2023,2024など）を取得する。
  const uniqueYears = [...new Set(sortedPosts.flatMap((post) => post.data.publishedDate.getFullYear()))];
  return uniqueYears.map((year) => {
    const yearFilteredPosts = sortedPosts.filter(
      (post) => post.data.publishedDate.getFullYear().toString() === year.toString(),
    );
    const uniqueMonths = [
      ...new Set(
        // getMonthは現実の数字から-1したものを返すので+1しておく。
        // そうじゃないとディレクトリ的にも-1した数字でアクセスすることになる。
        yearFilteredPosts.flatMap((post) => (post.data.publishedDate.getMonth() + 1).toString().padStart(2, '0')),
      ),
    ];
    return { props: { uniqueMonths }, params: { year: year.toString() } };
  });
}

const { uniqueMonths } = Astro.props;
const { year } = Astro.params;
---

<Layout title={`${year}年の投稿月一覧`} description={`${year}年の投稿があった月の一覧です。`}>
  <a href={`/archive/`} class="link-box"> &lt;&nbsp;投稿年一覧 </a>
  <ul class="mt-2 flex flex-row flex-wrap gap-2">
    {
      uniqueMonths.map((month) => (
        <li class="flex flex-col gap-1 p-2 border rounded-md border-gray-300 dark:border-gray-700">
          <h2 class="text-lg font-semibold">{month}月</h2>
          <ul class="flex flex-row gap-2">
            <li>
              <a href={`/archive/${year}/${month}/`} class="link-box">
                投稿日一覧
              </a>
            </li>
            <li>
              <a href={`/archive/${year}/${month}/posts/`} class="link-box">
                投稿一覧
              </a>
            </li>
          </ul>
        </li>
      ))
    }
  </ul>
</Layout>
