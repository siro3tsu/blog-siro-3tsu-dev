---
import { getSortedPosts } from '@utils';
import Layout from '@layouts/Layout.astro';

export async function getStaticPaths() {
  // すべての投稿を日付の新しいほうから古いほうへ並べる
  const sortedPosts = await getSortedPosts();
  // すべての投稿の中からすべての年（2023,2024など）を取得する。
  const uniqueYears = [...new Set(sortedPosts.flatMap((post) => post.data.publishedDate.getFullYear()))];

  // すべての年ごとに処理を行う。
  // ここでflatMapではなくflatを使うとエラーになるので注意（以下すべて同じ）
  return uniqueYears.flatMap((year) => {
    // その年の投稿を取得
    const yearFilteredPosts = sortedPosts.filter((post) => post.data.publishedDate.getFullYear() === year);
    // その年の投稿の中からすべての月(4,9など)を取得する。
    const uniqueMonths = [
      ...new Set(
        // getMonthは現実の数字から-1したものを返すので+1しておく。
        // そうじゃないとディレクトリ的にも-1した数字でアクセスすることになる。
        yearFilteredPosts.flatMap((post) => post.data.publishedDate.getMonth() + 1),
      ),
    ];
    return uniqueMonths.map((month) => {
      const monthFilteredPosts = yearFilteredPosts.filter((post) => post.data.publishedDate.getMonth() + 1 === month);
      const uniqueDays = [
        ...new Set(monthFilteredPosts.flatMap((post) => post.data.publishedDate.getDate().toString().padStart(2, '0'))),
      ];
      return {
        props: {
          uniqueDays,
        },
        params: {
          year: year.toString(),
          month: month.toString().padStart(2, '0'),
        },
      };
    });
  });
}
const { uniqueDays } = Astro.props;
const { year, month } = Astro.params;
---

<Layout title={`${year}年${month}月の投稿日一覧`} description={`${year}年${month}月の投稿があった日の一覧です。`}>
  <a href={`/archive/${year}/`} class="link-box">
    &lt;&nbsp;{year}年の投稿月一覧
  </a>
  <ul class="mt-2 flex flex-row flex-wrap gap-2">
    {
      uniqueDays.map((day) => (
        <li class="flex flex-col gap-1 p-2 border rounded-md border-gray-300 dark:border-gray-700">
          <h2 class="text-lg font-semibold">{day}日</h2>
          <ul>
            <li>
              <a href={`/archive/${year}/${month}/${day}/posts/`} class="link-box">
                投稿一覧
              </a>
            </li>
          </ul>
        </li>
      ))
    }
  </ul>
</Layout>
