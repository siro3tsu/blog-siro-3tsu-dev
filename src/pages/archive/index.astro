---
import { getSortedPosts } from '@core/posts';
import Layout from '@layouts/Layout.astro';

// すべての投稿を日付の新しいほうから古いほうへ並べる
const sortedPosts = await getSortedPosts();
// すべての投稿の中からすべての年（2023,2024など）を取得する。
const uniqueYears = [...new Set(sortedPosts.flatMap((post) => post.data.publishedDate.getFullYear()))];
---

<Layout title="投稿年一覧" description="投稿があった年の一覧です。">
  <ul class="flex flex-row flex-wrap gap-2">
    {
      uniqueYears.map((year) => (
        <li class="flex flex-col gap-1 p-2 border rounded-md border-gray-300 dark:border-gray-700">
          <h2 class="text-lg font-semibold">{year}年</h2>
          <ul class="flex flex-row gap-2">
            <li>
              <a href={`/archive/${year}/`} class="link-box">
                投稿月一覧
              </a>
            </li>
            <li>
              <a href={`/archive/${year}/posts/`} class="link-box">
                投稿一覧
              </a>
            </li>
          </ul>
        </li>
      ))
    }
  </ul>
</Layout>
