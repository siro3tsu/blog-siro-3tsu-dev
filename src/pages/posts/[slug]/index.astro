---
type Props = {
  post: CollectionEntry<'blog'>;
};
type HeadingListItem = {
  slug: string;
  text: string;
  children?: HeadingListItem[];
};

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import Layout from '@layouts/Layout.astro';
import CopyTexts from '@components/CopyTexts.astro';
import PostMeta from '@components/PostMeta.astro';
import LastUpdatedWarn from '@components/blog/LastUpdatedWarn';
import TocListItem from '@components/blog/TocListItem.astro';
import AboutAuthor from '@components/blog/AboutAuthor.astro';
import SharePost from '@components/blog/SharePost.astro';
import RecentPosts from '@components/blog/RecentPosts.astro';
import { getDescription } from '@core/posts';
import { siteConfig } from '@site.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const frontmatter = post.data;
const headingsList: HeadingListItem[] = [];
const stack: HeadingListItem[] = [];
headings.forEach((heading) => {
  const item = {
    slug: heading.slug,
    text: heading.text,
  };
  stack.length = heading.depth - 2;
  if (heading.depth === 2) {
    headingsList.push(item);
  } else {
    const parent = stack[stack.length - 1];
    if (parent) {
      parent.children ??= [];
      parent.children.push(item);
    }
  }
  stack.push(item);
});
---

<Layout
  title={frontmatter.title}
  useDefaultTitle={false}
  description={getDescription(post.body)}
  ogImagePath={`/posts/${post.id}/og-image.png`}
>
  <h1 class="text-3xl font-bold mb-4" data-pagefind-meta="title">{frontmatter.title}</h1>
  <LastUpdatedWarn updatedDate={frontmatter.updatedDate ?? frontmatter.publishedDate} client:load />
  <PostMeta frontmatter={frontmatter} mode="postPage" />
  {
    headingsList.length > 0 && (
      <div class="border rounded mt-4 px-4 py-2 w-fit toc-container">
        <h2 class="text-lg font-semibold flex flex-row items-center gap-1 cursor-pointer">
          目次
          <span class="icon-[mdi--chevron-down] in-open:icon-[mdi--chevron-up] text-2xl" />
        </h2>
        <div class="overflow-hidden max-h-0 in-open:max-h-[9999px] transition-[max-height] duration-300">
          <ol class="pt-2 toc flex flex-col gap-2 list-decimal list-inside">
            {headingsList.map((heading) => (
              <TocListItem heading={heading} />
            ))}
          </ol>
        </div>
      </div>
    )
  }
  <article data-pagefind-body>
    <Content />
  </article>
  <div class="flex flex-col gap-4 mt-8">
    <SharePost title={`${frontmatter.title} | ${siteConfig.siteName}`} />
    <AboutAuthor authorId={frontmatter.author} />
    <RecentPosts />
  </div>
  <CopyTexts />
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const tocContainer = document.querySelector('.toc-container');
      if (tocContainer) {
        const tocHeader = tocContainer.querySelector('h2');
        tocHeader.addEventListener('click', () => {
          if (tocContainer.hasAttribute('open')) {
            tocContainer.removeAttribute('open');
          } else {
            tocContainer.setAttribute('open', '');
          }
        });
      }
    });
  </script>
</Layout>
<style>
  @reference "@styles/global.css";

  article {
    @apply mt-12 prose prose-black prose-blue dark:prose-invert max-w-none;
    @apply prose-h1:mb-3 prose-h1:text-3xl prose-h1:font-bold prose-h1:pb-1 prose-h1:border-b prose-h1:border-gray-900 dark:prose-h1:border-gray-100;
    @apply prose-h2:my-2 prose-h2:text-2xl prose-h2:font-semibold prose-h2:pb-1 prose-h2:border-b prose-h2:border-gray-900 dark:prose-h2:border-gray-100;
    @apply prose-h3:my-2 prose-h3:text-xl prose-h3:font-medium prose-headings:relative prose-headings:hover:[&>a]:opacity-100 prose-headings:scroll-mt-20;
    @apply prose-code:bg-primary-200 prose-code:dark:bg-primary-900 prose-code:p-1 prose-code:mx-1 prose-code:rounded prose-code:not-data-copy:before:content-none prose-code:after:content-none;
    @apply prose-code:data-copy:cursor-pointer prose-code:data-copy:before:icon-[mdi--content-copy];
    @apply prose-code:data-copy:before:mr-1 prose-code:data-copy:before:text-lg prose-code:data-copy:before:align-text-bottom prose-code:data-copy:hover:bg-primary-300 prose-code:data-copy:hover:dark:bg-primary-700;
  }
</style>
