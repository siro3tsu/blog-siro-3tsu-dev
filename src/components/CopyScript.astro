---

<div
  class="copy-notification absolute opacity-0 transition-opacity bg-green-500/20 backdrop-blur-lg text-gray-900 dark:text-gray-100 border border-green-700 dark:border-green-300 rounded-md shadow-lg p-1 z-10 hidden flex-row items-center gap-2 pointer-events-none"
>
  <span class="icon-[material-symbols--check-circle-outline]"></span>コピーしました
</div>
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', (e) => {
        const textToCopy = el.getAttribute('data-copy');

        if (textToCopy && el.getAttribute('data-copied') !== 'true') {
          navigator.clipboard.writeText(textToCopy).then(() => {
            const copyNotification = document.querySelector('.copy-notification');
            const duplicateEl = copyNotification.cloneNode(true);
            document.body.appendChild(duplicateEl);
            duplicateEl.classList.remove('hidden');
            duplicateEl.classList.add('flex');
            if (e.pageX + duplicateEl.offsetWidth > window.scrollX + window.innerWidth) {
              duplicateEl.style.left = `${window.scrollX + window.innerWidth - duplicateEl.offsetWidth - 10}px`;
            } else {
              duplicateEl.style.left = `${e.pageX}px`;
            }
            console.log(e.pageY, duplicateEl.offsetHeight, window.innerHeight);
            if (e.pageY + duplicateEl.offsetHeight > window.scrollY + window.innerHeight) {
              duplicateEl.style.top = `${window.scrollY + window.innerHeight - duplicateEl.offsetHeight - 10}px`;
            } else {
              duplicateEl.style.top = `${e.pageY}px`;
            }
            duplicateEl.classList.remove('opacity-0');
            el.setAttribute('data-copied', 'true');
            setTimeout(() => {
              duplicateEl.classList.add('opacity-0');
              setTimeout(() => {
                duplicateEl.remove();
                el.removeAttribute('data-copied');
              }, 150);
            }, 2000);
          });
        }
      });
    });
  });
</script>
