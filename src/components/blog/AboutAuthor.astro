---
import { authorConfig } from '@site.config';
import { Image } from 'astro:assets';

const { authorId } = Astro.props;
const author = authorConfig.find((item) => item.id === authorId)!;
---

<div class="flex flex-row gap-2 items-center border rounded-md p-4 mt-4">
  <Image src={author.avatar} alt={`${author.name}のアバター`} width="128" height="128" class="rounded-full w-20 h-20" />
  <div class="flex flex-col gap-1">
    <p class="text-xl font-bold">{author.name}</p>
    <code>@{author.id}</code>
    <ul class="flex flex-row gap-2">
      {
        author.socialLinks.map((link) => (
          <li>
            {link.url ? (
              /https?:\/\//.test(link.url) ? (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  <span class={`${link.iconClass} text-xl`} />
                </a>
              ) : (
                <a href={link.url}>
                  <span class={`${link.iconClass} text-xl`} />
                </a>
              )
            ) : (
              <span
                class={`${link.iconClass} text-xl cursor-pointer`}
                data-copy={link.userId}
                data-copy-custom-msg="IDをコピーしました"
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>
</div>
