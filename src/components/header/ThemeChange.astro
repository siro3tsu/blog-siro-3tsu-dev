---
import { siteConfig } from '@site.config';
---

<div class="theme-change-component" transition:persist data-expressive-code-theme={siteConfig.expressiveCodeTheme}>
  <div class="relative hover:[&>div]:opacity-100">
    <button id="theme-button" class="[anchor-name:--theme-dialog] p-1 cursor-pointer" aria-label="テーマ変更">
      <div class="text-2xl w-6 h-6">
        <span class="mode-light icon-[material-symbols--light-mode-outline] hidden aria-current:block"></span>
        <span class="mode-dark icon-[material-symbols--dark-mode-outline] hidden aria-current:block"></span>
        <span class="mode-system-pc icon-[mdi--computer] hidden aria-current:block"></span>
        <span class="mode-system-sp icon-[mdi--smartphone] hidden aria-current:block"></span>
      </div>
    </button>
    <div
      class="absolute opacity-0 transition-opacity top-10 -right-8 sm:max-[940px]:-right-2 w-24 text-center bg-default-bg/70 dark:bg-default-bg-dark/70 backdrop-blur-xs text-gray-900 dark:text-gray-100 border border-gray-500 rounded-md shadow-lg p-1 z-50 pointer-events-none"
    >
      テーマ変更
    </div>
  </div>
  <dialog
    id="theme-dialog"
    class="[position-anchor:--theme-dialog] [position-area:bottom] mt-1 mr-2 bg-default-bg/70 dark:bg-default-bg-dark/70 backdrop-blur-xs text-gray-900 dark:text-gray-100 border border-gray-500 rounded-md shadow-lg backdrop:bg-transparent"
  >
    <ul class="p-1 flex flex-col gap-1">
      <li>
        <button value="light" type="button" class="theme-change-btn">
          <span class="icon-[material-symbols--light-mode-outline] text-lg"></span>ライトモード
        </button>
      </li>
      <li>
        <button value="dark" type="button" class="theme-change-btn">
          <span class="icon-[material-symbols--dark-mode-outline] text-lg"></span>ダークモード
        </button>
      </li>
      <li>
        <button value="system" type="button" class="theme-change-btn">
          <span class="system-pc icon-[mdi--computer] text-lg"></span>
          <span class="system-sp icon-[mdi--smartphone] text-lg"></span>
          システム設定
        </button>
      </li>
    </ul>
  </dialog>
  <iframe src="https://siro.3tsu.dev/theme-sync/" class="hidden"></iframe>
</div>
<script is:inline>
  const themeChangeComponent = document.querySelector('.theme-change-component');
  let deviceType = 'pc';
  // switch system icon based on device type (PC or SP)
  if (window.matchMedia('(max-width: 768px) and (hover: none) and (pointer: coarse)').matches) {
    themeChangeComponent.querySelector('.system-pc').classList.add('hidden');
    deviceType = 'sp';
  } else {
    themeChangeComponent.querySelector('.system-sp').classList.add('hidden');
    deviceType = 'pc';
  }

  // initialize theme change component based on localStorage or system preference
  const initialTheme = localStorage.getItem('theme') || 'system';
  themeChangeComponent
    .querySelectorAll(`button[value="${initialTheme}"], .mode-${initialTheme}, .mode-${initialTheme}-${deviceType}`)
    .forEach((el) => el.setAttribute('aria-current', 'true'));
</script>
<script>
  const themeChangeComponent = document.querySelector('.theme-change-component') as HTMLElement;
  const expressiveCodeTheme = themeChangeComponent.dataset.expressiveCodeTheme!.split(',');
  const changeTheme = (theme: 'light' | 'dark' | 'system') => {
    themeChangeComponent
      .querySelectorAll(`button[value="${theme}"], .mode-${theme}, .mode-${theme}-${deviceType}`)
      .forEach((el) => el.setAttribute('aria-current', 'true'));
    const root = document.documentElement;
    root.classList.add('[&_*:not(header):not(header_*)]:transition-none!');
    window.requestAnimationFrame(() => {
      root.classList.remove('[&_*:not(header):not(header_*)]:transition-none!');
    });
    if (theme === 'system') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    if (theme === 'light') {
      document.documentElement.dataset.theme = 'light';
      document.documentElement.dataset.pfTheme = 'light';
    } else if (theme === 'dark') {
      document.documentElement.dataset.theme = 'dark';
      document.documentElement.dataset.pfTheme = 'dark';
    }
    changePostComponentsTheme(theme);
  };
  const setGiscusTheme = (theme: 'light' | 'dark') => {
    const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
    if (!iframe) return;

    try {
      if (iframe.contentWindow?.location.href === 'about:blank') {
        // iframeがまだロードされていない場合は、loadイベントを待つ
        iframe.addEventListener('load', () => {
          iframe.contentWindow!.postMessage(
            {
              giscus: {
                setConfig: {
                  theme: theme,
                },
              },
            },
            'https://giscus.app'
          );
        });
        return;
      }
    } catch (e) {
      // クロスオリジンの制約でiframe.contentWindow.location.hrefにアクセスできない場合は、読み込まれたと仮定してpostMessageを送信する
    }
    iframe.contentWindow!.postMessage(
      {
        giscus: {
          setConfig: {
            theme: theme,
          },
        },
      },
      'https://giscus.app'
    );
  };
  const changePostComponentsTheme = (theme: 'light' | 'dark' | 'system') => {
    if (theme === 'system') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    if (theme === 'light') {
      // mermaidのdarkモード時のsourceをimgの後ろに持ってくる
      document.querySelectorAll('[id^="mermaid-dark-"]').forEach((el) => {
        el.parentNode!.insertBefore(el, el.parentNode!.querySelector('img')!.nextSibling);
      });
      (document.querySelectorAll('.expressive-code') as NodeListOf<HTMLElement>).forEach((el) => {
        el.dataset.theme = expressiveCodeTheme[1];
      });
      setGiscusTheme('light');
    } else if (theme === 'dark') {
      // mermaidのdarkモード時のsourceをimgの前に持ってくる
      document.querySelectorAll('[id^="mermaid-dark-"]').forEach((el) => {
        el.parentNode!.insertBefore(el, el.parentNode!.querySelector('img')!);
      });
      (document.querySelectorAll('.expressive-code') as NodeListOf<HTMLElement>).forEach((el) => {
        el.dataset.theme = expressiveCodeTheme[0];
      });
      setGiscusTheme('dark');
    }
  };
  const sendThemeToIframe = (theme: 'light' | 'dark' | 'system') => {
    const iframe = document.querySelector('iframe[src="https://siro.3tsu.dev/theme-sync/"]') as HTMLIFrameElement;
    if (!iframe) return;
    iframe.contentWindow!.postMessage(
      {
        theme: theme,
      },
      'https://siro.3tsu.dev'
    );
  };
  let deviceType: 'pc' | 'sp' = 'pc';
  // switch system icon based on device type (PC or SP)
  if (window.matchMedia('(max-width: 768px) and (hover: none) and (pointer: coarse)').matches) {
    deviceType = 'sp';
  } else {
    deviceType = 'pc';
  }

  // apply theme before view transition complete to avoid flickering
  document.addEventListener('astro:after-swap', () =>
    changeTheme((localStorage.getItem('theme') as 'light' | 'dark' | 'system') || 'system')
  );
  document.addEventListener('astro:page-load', () =>
    changePostComponentsTheme((localStorage.getItem('theme') as 'light' | 'dark' | 'system') || 'system')
  );
  window.addEventListener('storage', (e) => {
    if (e.key === 'theme') {
      themeChangeComponent
        .querySelectorAll('button[aria-current], [class^="mode-"][aria-current]')
        .forEach((el) => el.removeAttribute('aria-current'));
      changeTheme((e.newValue as 'light' | 'dark' | 'system') || 'system');
      changePostComponentsTheme((e.newValue as 'light' | 'dark' | 'system') || 'system');
    }
  });
  const themeDialog = document.querySelector('#theme-dialog') as HTMLDialogElement;
  const themeButton = document.querySelector('#theme-button') as HTMLButtonElement;
  const themeButtons = themeDialog.querySelectorAll('button');
  themeButton.addEventListener('click', () => {
    themeDialog.showModal();
  });
  themeDialog.addEventListener('click', (e) => {
    if (e.target === themeDialog) {
      themeDialog.close();
    }
  });
  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const currentTheme = button.value as 'light' | 'dark' | 'system';
      themeChangeComponent
        .querySelectorAll('button[aria-current], [class^="mode-"][aria-current]')
        .forEach((el) => el.removeAttribute('aria-current'));
      changeTheme(currentTheme);
      sendThemeToIframe(currentTheme);
      localStorage.setItem('theme', currentTheme);
      themeDialog.close();
    });
  });
</script>
<style>
  @reference '@styles/global.css';
  .theme-change-btn {
    @apply w-full rounded-md px-1 py-2 text-left aria-current:bg-primary-300/70 dark:aria-current:bg-primary-700/70 hover:bg-primary-200/70 dark:hover:bg-primary-800/70 hover:aria-current:bg-primary-300/50 dark:hover:aria-current:bg-primary-700/90 flex flex-row items-center gap-1 cursor-pointer;
  }
</style>
