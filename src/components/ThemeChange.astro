---
import { siteConfig } from '@site.config';
---

<div class="theme-change-component" transition:persist data-expressive-code-theme={siteConfig.expressiveCodeTheme}>
  <div class="relative hover:[&>div]:opacity-100">
    <button
      popovertarget="theme-popover"
      class="[anchor-name:--theme-popover] p-1 sm:align-middle cursor-pointer"
      aria-label="テーマ変更"
    >
      <div class="text-2xl w-6 h-6">
        <span class="mode-light icon-[material-symbols--light-mode-outline] hidden aria-current:block"></span>
        <span class="mode-dark icon-[material-symbols--dark-mode-outline] hidden aria-current:block"></span>
        <span class="mode-system-pc icon-[mdi--computer] hidden aria-current:block"></span>
        <span class="mode-system-sp icon-[mdi--smartphone] hidden aria-current:block"></span>
      </div>
    </button>
    <div
      class="absolute opacity-0 transition-opacity top-10 -right-8 sm:max-[940px]:-right-2 w-24 text-center bg-default-bg/70 dark:bg-default-bg-dark/70 backdrop-blur-lg text-gray-900 dark:text-gray-100 border border-gray-500 rounded-md shadow-lg p-1 z-10 pointer-events-none"
    >
      テーマ変更
    </div>
  </div>
  <div
    id="theme-popover"
    popover
    class="[position-anchor:--theme-popover] [position-area:bottom] mt-1 mr-2 bg-default-bg/70 dark:bg-default-bg-dark/70 backdrop-blur-lg text-gray-900 dark:text-gray-100 border border-gray-500 rounded-md shadow-lg p-1 z-20 open:pointer-events-auto"
  >
    <ul class="flex flex-col gap-2">
      <li>
        <button value="light" type="button" class="theme-change-btn">
          <span class="icon-[material-symbols--light-mode-outline]"></span>ライトモード
        </button>
      </li>
      <li>
        <button value="dark" type="button" class="theme-change-btn">
          <span class="icon-[material-symbols--dark-mode-outline]"></span>ダークモード
        </button>
      </li>
      <li>
        <button value="system" type="button" class="theme-change-btn">
          <span class="system-pc icon-[mdi--computer] mr-1"></span>
          <span class="system-sp icon-[mdi--smartphone] mr-1"></span>
          システム設定
        </button>
      </li>
    </ul>
  </div>
</div>
<script is:inline>
  const themeChangeComponent = document.querySelector('.theme-change-component');
  const expressiveCodeTheme = themeChangeComponent.getAttribute('data-expressive-code-theme').split(',');
  const changeTheme = (theme) => {
    themeChangeComponent
      .querySelectorAll(`button[value="${theme}"], .mode-${theme}, .mode-${theme}-${deviceType}`)
      .forEach((el) => el.setAttribute('aria-current', 'true'));
    const root = document.documentElement;
    root.classList.add('[&_*]:!transition-none');
    if (theme === 'system') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    if (theme === 'light') {
      document.documentElement.setAttribute('data-pf-theme', 'light');
    } else if (theme === 'dark') {
      document.documentElement.setAttribute('data-pf-theme', 'dark');
    }
    changePostComponentsTheme(theme);
    window.requestAnimationFrame(() => {
      root.classList.remove('[&_*]:!transition-none');
    });
  };
  const changePostComponentsTheme = (theme) => {
    if (theme === 'system') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    if (theme === 'light') {
      // mermaidのdarkモード時のsourceをimgの後ろに持ってくる
      document.querySelectorAll('[id^="mermaid-dark-"]').forEach((el) => {
        el.parentNode.insertBefore(el, el.parentNode.querySelector('img').nextSibling);
      });
      document.querySelectorAll('.expressive-code').forEach((el) => {
        el.setAttribute('data-pf-theme', expressiveCodeTheme[1]);
      });
    } else if (theme === 'dark') {
      // mermaidのdarkモード時のsourceをimgの前に持ってくる
      document.querySelectorAll('[id^="mermaid-dark-"]').forEach((el) => {
        el.parentNode.insertBefore(el, el.parentNode.querySelector('img'));
      });
      document.querySelectorAll('.expressive-code').forEach((el) => {
        el.setAttribute('data-pf-theme', expressiveCodeTheme[0]);
      });
    }
  };
  let deviceType;
  if (window.matchMedia('(max-width: 768px) and (hover: none) and (pointer: coarse)').matches) {
    themeChangeComponent.querySelector('.system-pc').classList.add('hidden');
    deviceType = 'sp';
  } else {
    themeChangeComponent.querySelector('.system-sp').classList.add('hidden');
    deviceType = 'pc';
  }
  changeTheme(localStorage.getItem('theme') || 'system');
  document.addEventListener('astro:page-load', () =>
    changePostComponentsTheme(localStorage.getItem('theme') || 'system'),
  );
  document.addEventListener('astro:after-swap', () => changeTheme(localStorage.getItem('theme') || 'system'));
  const themePopover = document.querySelector('#theme-popover');
  const themeButtons = themePopover.querySelectorAll('button');
  themeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const currentTheme = button.value;
      themeChangeComponent
        .querySelectorAll('button[aria-current], [class^="mode-"][aria-current]')
        .forEach((el) => el.removeAttribute('aria-current'));
      changeTheme(currentTheme);
      localStorage.setItem('theme', currentTheme);
      themePopover.hidePopover();
    });
  });
</script>
<style>
  @reference '../styles/global.css';
  .theme-change-btn {
    @apply w-full rounded-md px-1 py-2 text-left aria-current:bg-primary-300/70 dark:aria-current:bg-primary-700/70 hover:bg-primary-200/70 dark:hover:bg-primary-800/70 hover:aria-current:bg-primary-300/50 dark:hover:aria-current:bg-primary-700/90 flex flex-row items-center gap-1 cursor-pointer;
  }
</style>
