<script>
  document.addEventListener('astro:page-load', () => {
    (document.querySelectorAll('[data-copy]') as NodeListOf<HTMLElement>).forEach((el) => {
      el.addEventListener('click', (e) => {
        const textToCopy = el.dataset.copy;

        if (textToCopy && el.dataset.copied !== 'true') {
          navigator.clipboard.writeText(textToCopy).then(() => {
            const copyNotification = document.createElement('DIV');
            copyNotification.className =
              'copy-notification absolute opacity-0 transition-opacity bg-green-500/20 backdrop-blur-sm text-gray-900 dark:text-gray-100 border border-green-700 dark:border-green-300 rounded-md shadow-lg p-1 z-10 hidden flex-row items-center gap-2 pointer-events-none';
            copyNotification.innerHTML = `<span class="icon-[mdi--check-circle-outline]"></span>${el.dataset.copyCustomMsg || 'コピーしました'}`;
            document.body.appendChild(copyNotification);
            copyNotification.classList.remove('hidden');
            copyNotification.classList.add('flex');
            if (e.pageX + copyNotification.offsetWidth > window.scrollX + window.innerWidth) {
              copyNotification.style.left = `${window.scrollX + window.innerWidth - copyNotification.offsetWidth - 10}px`;
            } else {
              copyNotification.style.left = `${e.pageX}px`;
            }
            if (e.pageY + copyNotification.offsetHeight > window.scrollY + window.innerHeight) {
              copyNotification.style.top = `${window.scrollY + window.innerHeight - copyNotification.offsetHeight - 10}px`;
            } else {
              copyNotification.style.top = `${e.pageY}px`;
            }
            copyNotification.classList.remove('opacity-0');
            el.dataset.copied = 'true';
            setTimeout(() => {
              copyNotification.classList.add('opacity-0');
              setTimeout(() => {
                copyNotification.remove();
                delete el.dataset.copied;
              }, 150);
            }, 2000);
          });
        }
      });
    });
  });
</script>
