---
const { currentPage, totalPages, basePath } = Astro.props;
---

<div class="flex flex-col items-center mt-4">
  <nav class="flex justify-center">
    {
      currentPage > 1 ? (
        <a
          href={`${basePath}/${currentPage - 1 === 1 ? '' : currentPage - 1 + '/'}`}
          class="px-4 py-2 mx-1 bg-gray-200 dark:bg-gray-800 rounded hover:bg-gray-300 dark:hover:bg-gray-700"
        >
          &laquo;
        </a>
      ) : (
        <span class="px-4 py-2 mx-1 invisible">&nbsp;</span>
      )
    }
    {
      Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
        page === currentPage ? (
          <span class="px-4 py-2 mx-1 bg-primary-300 dark:bg-primary-700 rounded">{page}</span>
        ) : (
          <a
            href={`${basePath}/${page === 1 ? '' : page + '/'}`}
            class="px-4 py-2 mx-1 bg-gray-200 dark:bg-gray-800 rounded hover:bg-gray-300 dark:hover:bg-gray-700"
          >
            {page}
          </a>
        ),
      )
    }
    {
      currentPage < totalPages ? (
        <a
          href={`${basePath}/${currentPage + 1}/`}
          class="px-4 py-2 mx-1 bg-gray-200 dark:bg-gray-800 rounded hover:bg-gray-300 dark:hover:bg-gray-700"
        >
          &raquo;
        </a>
      ) : (
        <span class="px-4 py-2 mx-1 invisible">&nbsp;</span>
      )
    }
  </nav>
  <p>{currentPage}/{totalPages}ページ</p>
</div>
