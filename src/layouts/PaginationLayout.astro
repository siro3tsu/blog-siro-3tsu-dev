---
import type { CollectionEntry } from 'astro:content';

type Props = {
  page: {
    data: CollectionEntry<'blog'>[];
    currentPage: number;
    lastPage: number;
  };
  title: string;
  description?: string;
  basePath: string;
  showTitle?: boolean;
};
import Layout from '@layouts/Layout.astro';
import PostCard from '@components/PostCard.astro';
import Paging from '@components/Paging.astro';

const { page, title, description, basePath, showTitle = true } = Astro.props;
---

<Layout
  title={title + ` (${page.currentPage}/${page.lastPage}ページ)`}
  description={description}
  useDefaultTitle={false}
>
  {showTitle && <h1 class="text-3xl font-bold mb-6">{title}</h1>}
  <ul class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-2">
    {page.data.map((post) => <PostCard slug={`/posts/${post.id}`} frontmatter={post.data} />)}
  </ul>
  <Paging currentPage={page.currentPage} totalPages={page.lastPage} basePath={basePath} />
</Layout>
