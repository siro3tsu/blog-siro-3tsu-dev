---
import Layout from '@layouts/Layout.astro';
const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} useDefaultTitle={false} description={frontmatter.description} blockIndexing={true}>
  <article class="prose prose-black prose-blue dark:prose-invert max-w-none">
    <h1>{frontmatter.title}</h1>
    <slot />
  </article>
</Layout>
<style>
  @reference "@styles/global.css";

  article {
    @apply prose-h1:mb-3 prose-h1:text-3xl prose-h1:font-bold prose-h1:pb-1 prose-h1:border-b prose-h1:border-gray-900 dark:prose-h1:border-gray-100;
    @apply prose-h2:my-2 prose-h2:text-2xl prose-h2:font-semibold prose-h2:pb-1 prose-h2:border-b prose-h2:border-gray-900 dark:prose-h2:border-gray-100;
    @apply prose-h3:my-2 prose-h3:text-xl prose-h3:font-medium;
  }
</style>
