{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist"
],
"compilerOptions": {
    "types": [
        "./worker-configuration.d.ts"
    ],
    "paths": {
      "@layouts/*": ["./src/layouts/*"],
      "@components/*": ["./src/components/*"],
      "@site.config": ["./src/site.config.ts"],
      "@utils": ["./src/utils.ts"],
    },
}
}